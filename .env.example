# Required
DATABASE_URL=postgresql+psycopg://isomorf:isomorf@localhost:5432/isomorf
JWT_SECRET_KEY=change-me-in-production

# Auth tokens
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS — origin allowed to call the API
FRONTEND_URL=http://localhost:3000

# Session cookies
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_NAME=isomorf_session
REFRESH_COOKIE_NAME=isomorf_refresh
AUTH_HINT_COOKIE_NAME=isomorf_auth_hint

# Device-proof signature freshness window (seconds)
DEVICE_PROOF_MAX_AGE_SECONDS=90
